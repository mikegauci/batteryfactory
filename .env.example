NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (project batteryfactory, ref dvrjnuvpvkvoyndnrwqr)
NEXT_PUBLIC_SUPABASE_URL=https://dvrjnuvpvkvoyndnrwqr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: contact uploads, Stripe webhook, migration import.
SUPABASE_SECRET_KEY=

# Mailjet (transactional email). Without keys, emails are logged instead of sent.
MAILJET_API_KEY=
MAILJET_API_SECRET=
EMAIL_FROM=info@batteryfactory.mt
# Where contact form and order notifications go (defaults to info@batteryfactory.mt)
EMAIL_ADMIN_TO=

# Stripe keys are entered in the admin (Settings → Stripe), not here.

# WooCommerce read-only REST API key (only needed for migration)
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Any long random string; Vercel Cron sends it to /api/cron/checkouts/.
CRON_SECRET=
